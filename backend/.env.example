# Flask only; never prefix these with VITE_.
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
CARTOGRAPHER_IMAGERY_PROVIDER=google
# Server ceiling; each search chooses 4–48 images (default 16).
CARTOGRAPHER_MAX_IMAGES=48
# Portable project-local MongoDB; the npm launcher starts this automatically.
CARTOGRAPHER_MONGODB_URI=mongodb://127.0.0.1:27018
CARTOGRAPHER_MONGODB_DATABASE=cartographer
# Optional image-cache directory; default is backend/.cache.
# CARTOGRAPHER_CACHE_DIRECTORY=/absolute/path/to/Cartographer/backend/.cache
# Optional: path to a JSON array of owned/licensed local images.
# CARTOGRAPHER_IMAGERY_MANIFEST=.cache/imagery-manifest.json
# Optional compatible geocoder; remote searches are explicitly submitted.
# CARTOGRAPHER_GEOCODER_URL=
# CARTOGRAPHER_GEOCODER_USER_AGENT=
