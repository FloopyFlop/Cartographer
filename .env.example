# Flask runtime credentials only. Never use VITE_ prefixes or Docker build args.
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
CARTOGRAPHER_IMAGERY_PROVIDER=google
CARTOGRAPHER_MAX_IMAGES=48
CARTOGRAPHER_MONGODB_DATABASE=cartographer

# Required for Docker Compose / Coolify. The local npm launcher remains private
# to localhost and open unless CARTOGRAPHER_AUTH_REQUIRED=true is explicitly set.
CARTOGRAPHER_AUTH_USERNAME=cartographer
CARTOGRAPHER_AUTH_PASSWORD=
# CARTOGRAPHER_AUTH_REQUIRED=true

# Local portable MongoDB default; Compose supplies its internal MongoDB URI.
# CARTOGRAPHER_MONGODB_URI=mongodb://127.0.0.1:27018
